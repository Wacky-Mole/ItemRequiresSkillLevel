    </ReadLinesFromFile>
    <PropertyGroup>
      <ManifestContent>@(ManifestLines,'&#x0D;&#x0A;')</ManifestContent>
      <UpdatedManifestContent>$([System.Text.RegularExpressions.Regex]::Replace('$(ManifestContent)', '$(ManifestVersionPattern)', '$(ManifestVersionReplacement)'))</UpdatedManifestContent>
